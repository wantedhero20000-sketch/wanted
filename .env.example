# ─── إلزامية ───────────────────────────────────────────────────
# قاعدة Turso (أنشئ مجانية: turso db create <name> ثم turso db show <name> --url)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# توكن بصلاحيات كتابة (turso db tokens create <name>)
TURSO_AUTH_TOKEN=

# عنوان خدمة دمج الفيديو (Video Merger API v2) — بلا مفاتيح
MERGER_API_BASE=https://<your-merger-service>

# ─── اختيارية ─────────────────────────────────────────────────
# إن ضُبطت يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=
# تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
COMETAPI_BASE=
